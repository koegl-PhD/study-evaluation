{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Slicer debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/fryderyk/Documents/code/Slicer-SuperBuild-Debug/Slicer-build/Slicer",
            "args": [],
            "stopAtEntry": false,
            "cwd": ".",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Slicer Python",
            "type": "python",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
        },
        {
            "name": "Python: Debug current file",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "debugStdLib": true
        }
    ]
}